# 由 nginx 镜像启动时渲染（只替换已定义的环境变量，如 BACKEND_UPSTREAM；nginx 自己的 $host 等原样保留）。

# 容器内的 Docker DNS：配合下面用变量写 proxy_pass，按请求解析后端地址 ——
# 后端还没起来或重建换了 IP 时 nginx 也能启动、之后自动连上。
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  set $backend http://${BACKEND_UPSTREAM};

  # 接口：原样转发（用变量的 proxy_pass 不改写 URI）
  location /api/ {
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
  }

  # 实时推送（WebSocket）：长连接，读超时放长
  location = /ws {
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # 带内容哈希的构建产物：长缓存
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # 单页应用：其余路径都回 index.html（不缓存，发版后立即生效）
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
